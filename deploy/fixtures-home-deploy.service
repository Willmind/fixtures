[Unit]
Description=Update fixtures home from verified public build
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=fixtures-deploy
Group=fixtures-deploy
Environment=HOME=/var/lib/fixtures-home-deploy
ExecStart=/usr/local/libexec/fixtures-home-deploy
TimeoutStartSec=720
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/fixtures-home /var/lib/fixtures-home-deploy
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
